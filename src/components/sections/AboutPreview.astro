---
import { Camera, Video, Award, Heart, Star, MapPin, Clock, Users } from 'lucide-react';

const stats = [
  { value: '150+', label: 'Events Captured', icon: Camera },
  { value: '50+', label: 'Weddings Filmed', icon: Heart },
  { value: '8+', label: 'Years Experience', icon: Clock },
  { value: '100%', label: 'Client Satisfaction', icon: Star },
];

const values = [
  {
    title: 'Story First',
    description: 'Every event has a unique narrative. We find the emotional threads and weave them into a story you\'ll watch for generations.',
    icon: Heart,
  },
  {
    title: 'Cinematic Quality',
    description: 'Broadcast-grade equipment, professional lighting, and cinema-style editing. Your memories deserve the big-screen treatment.',
    icon: Camera,
  },
  {
    title: 'Unobtrusive Presence',
    description: 'We blend into your day. No awkward posing, no intrusive directions — just authentic moments captured naturally.',
    icon: Users,
  },
  {
    title: 'Reliable Delivery',
    description: 'Clear timelines, secure backups, and consistent communication. You\'ll never wonder when you\'ll see your photos.',
    icon: Award,
  },
];

const team = [
  {
    name: 'PhotoCut4u Team',
    role: 'Lead Photographer & Videographer',
    bio: '8+ years capturing weddings, events, and portraits across the UK. Passionate about cinematic storytelling and authentic moments.',
    image: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&h=400&fit=crop&crop=face',
  },
];
---

<section id="about" class="section bg-white" aria-labelledby="about-heading">
  <div class="container-custom">
    <!-- Stats Bar -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 mb-16">
      {stats.map((stat) => (
        <div class="text-center p-6 bg-slate-50 rounded-2xl">
          <div class="w-14 h-14 rounded-xl bg-slate-900 flex items-center justify-center mx-auto mb-4">
            <stat.icon class="w-7 h-7 text-white" aria-hidden="true" />
          </div>
          <div class="text-3xl lg:text-4xl font-bold text-slate-900">{stat.value}</div>
          <div class="text-slate-600 text-sm mt-1">{stat.label}</div>
        </div>
      ))}
    </div>

    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Content -->
      <div>
        <h2 id="about-heading" class="section-title">Your Story, <span class="text-amber-500">Our Lens</span></h2>
        <div class="space-y-4 text-slate-600 text-lg leading-relaxed">
          <p>
            Hi, I'm the face behind Photocut4u. What started as a passion for capturing fleeting moments
            has grown into a full-time pursuit of cinematic storytelling across the UK.
          </p>
          <p>
            Based in Slough, Berkshire, I've had the privilege of documenting over 150 events — from
            intimate church ceremonies to grand wedding celebrations, corporate conferences to newborn
            first days. Every client, every event, every story is different. And that's what makes this work meaningful.
          </p>
          <p>
            My approach is simple: <strong>be present, stay invisible, capture truth.</strong> The best photos
            and videos happen when you forget the camera is there. I use professional cinema cameras,
            fast primes, and natural light to create images that feel timeless — not trendy.
          </p>
        </div>

        <!-- Values -->
        <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-6">
          {values.map((value) => (
            <div class="flex gap-4 p-4 rounded-xl bg-slate-50 hover:bg-slate-100 transition-colors">
              <div class="w-12 h-12 rounded-xl bg-slate-900 flex items-center justify-center flex-shrink-0">
                <value.icon class="w-6 h-6 text-white" aria-hidden="true" />
              </div>
              <div>
                <h4 class="font-semibold text-slate-900 mb-1">{value.title}</h4>
                <p class="text-slate-600 text-sm">{value.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Image/Video Placeholder -->
      <div class="relative">
        <div class="relative aspect-[4/5] rounded-2xl overflow-hidden bg-slate-100">
          <img
            src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=800&h=1000&fit=crop&crop=face"
            alt="Photographer at work"
            class="w-full h-full object-cover"
          />
          <!-- Play button overlay for showreel -->
          <a
            href="https://www.youtube.com/@photocut4u"
            target="_blank"
            rel="noopener noreferrer"
            class="absolute inset-0 flex items-center justify-center bg-slate-900/50 hover:bg-slate-900/70 transition-colors"
            aria-label="Watch our showreel on YouTube"
          >
            <div class="w-20 h-20 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center border-4 border-white/30 hover:border-white/50 transition-all">
              <svg class="w-8 h-8 text-white ml-1" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M8 5v14l11-7z" />
              </svg>
            </div>
          </a>
        </div>

        <!-- Location badge -->
        <div class="absolute bottom-6 left-6 bg-white/95 backdrop-blur-sm px-4 py-3 rounded-xl shadow-lg flex items-center gap-2">
          <MapPin class="w-5 h-5 text-amber-500" aria-hidden="true" />
          <span class="font-medium text-slate-900">Slough, Berkshire, UK</span>
        </div>
      </div>
    </div>
  </div>
</section>