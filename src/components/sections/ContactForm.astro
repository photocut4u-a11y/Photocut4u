---
import { Mail, Phone, MapPin, Calendar, Camera, Video, Heart, Sparkles, Users, Building2, Church, Baby, ChevronRight, CheckCircle, AlertCircle, Loader2 } from 'lucide-react';

const serviceOptions = [
  { value: 'weddings', label: 'Weddings & Engagements' },
  { value: 'events', label: 'Events & Parties' },
  { value: 'portraits', label: 'Portraits & Family' },
  { value: 'corporate', label: 'Corporate & Commercial' },
  { value: 'church', label: 'Church & Worship' },
  { value: 'baby', label: 'Newborn & Baby' },
  { value: 'other', label: 'Something Else' },
];

const contactInfo = [
  {
    icon: Mail,
    title: 'Email',
    value: 'Photocut4u@gmail.com',
    href: 'mailto:Photocut4u@gmail.com',
    description: 'We reply within 24 hours',
  },
  {
    icon: Phone,
    title: 'Phone',
    value: '+44 7XXX YYY YYY',
    href: 'tel:+447XXYYYYYY',
    description: 'Mon-Sat, 9am-6pm',
  },
  {
    icon: MapPin,
    title: 'Studio',
    value: 'Slough, Berkshire, UK',
    href: 'https://maps.google.com/?q=Slough+Berkshire',
    description: 'By appointment only',
  },
  {
    icon: Calendar,
    title: 'Book a Call',
    value: 'Calendly',
    href: 'https://calendly.com/photocut4u',
    description: 'Free 15-min consultation',
  },
];
---

<section class="section bg-white" aria-labelledby="contact-heading">
  <div class="container-custom">
    <div class="text-center mb-12">
      <h1 id="contact-heading" class="section-title">Let's Create Together</h1>
      <p class="section-subtitle mx-auto">
        Ready to book? Have questions? Fill out the form and we'll get back within 24 hours.
        <br class="hidden sm:inline" /> Or use the quick contacts below.
      </p>
    </div>

    <div class="grid lg:grid-cols-3 gap-12">
      <!-- Contact Info -->
      <div class="lg:col-span-1 space-y-8">
        <div class="bg-slate-50 rounded-2xl p-8">
          <h3 class="text-xl font-bold text-slate-900 mb-6">Quick Contact</h3>
          <div class="space-y-6">
            {contactInfo.map((item) => (
              <a href={item.href} target="_blank" rel="noopener noreferrer" class="flex items-start gap-4 p-4 rounded-xl bg-white hover:bg-slate-50 transition-colors group">
                <div class="w-10 h-10 rounded-lg bg-slate-900 flex items-center justify-center flex-shrink-0 group-hover:bg-amber-500 transition-colors">
                  <item.icon class="w-5 h-5 text-white" aria-hidden="true" />
                </div>
                <div>
                  <p class="font-medium text-slate-900">{item.title}</p>
                  <p class="text-slate-600 text-sm">{item.value}</p>
                  <p class="text-xs text-slate-400 mt-1">{item.description}</p>
                </div>
                <ChevronRight class="w-4 h-4 text-slate-400 mt-1 group-hover:text-amber-500 transition-colors" aria-hidden="true" />
              </a>
            ))}
          </div>
        </div>

        <!-- Service Quick Select -->
        <div class="bg-slate-900 rounded-2xl p-8 text-white">
          <h3 class="text-xl font-bold mb-6">Popular Services</h3>
          <ul class="space-y-3">
            {serviceOptions.map((opt) => (
              <li key={opt.value}>
                <a href={`/contact?service=${opt.value}`} class="flex items-center gap-3 p-3 rounded-lg bg-white/5 hover:bg-white/10 transition-colors">
                  {opt.value === 'weddings' && <Heart class="w-5 h-5 text-amber-400" aria-hidden="true" />}
                  {opt.value === 'events' && <Sparkles class="w-5 h-5 text-amber-400" aria-hidden="true" />}
                  {opt.value === 'portraits' && <Users class="w-5 h-5 text-amber-400" aria-hidden="true" />}
                  {opt.value === 'corporate' && <Building2 class="w-5 h-5 text-amber-400" aria-hidden="true" />}
                  {opt.value === 'church' && <Church class="w-5 h-5 text-amber-400" aria-hidden="true" />}
                  {opt.value === 'baby' && <Baby class="w-5 h-5 text-amber-400" aria-hidden="true" />}
                  {opt.value === 'other' && <Camera class="w-5 h-5 text-amber-400" aria-hidden="true" />}
                  <span class="font-medium">{opt.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Form -->
      <div class="lg:col-span-2">
        <form id="contact-form" class="bg-white border border-slate-200 rounded-2xl p-8" novalidate>
          <div class="grid md:grid-cols-2 gap-6 mb-6">
            <div>
              <label for="name" class="label">Full Name *</label>
              <input type="text" id="name" name="name" required class="input-field" placeholder="John Smith" autocomplete="name" />
            </div>
            <div>
              <label for="email" class="label">Email Address *</label>
              <input type="email" id="email" name="email" required class="input-field" placeholder="john@example.com" autocomplete="email" />
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-6 mb-6">
            <div>
              <label for="phone" class="label">Phone Number</label>
              <input type="tel" id="phone" name="phone" class="input-field" placeholder="+44 7XXX YYY YYY" autocomplete="tel" />
            </div>
            <div>
              <label for="service" class="label">Service Interested In *</label>
              <select id="service" name="service" required class="input-field appearance-none">
                <option value="">Select a service...</option>
                {serviceOptions.map((opt) => (
                  <option value={opt.value}>{opt.label}</option>
                ))}
              </select>
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-6 mb-6">
            <div>
              <label for="date" class="label">Event Date (approx.)</label>
              <input type="date" id="date" name="date" class="input-field" />
            </div>
            <div>
              <label for="location" class="label">Event Location</label>
              <input type="text" id="location" name="location" class="input-field" placeholder="Venue, City" />
            </div>
          </div>

          <div class="mb-6">
            <label for="message" class="label">Tell Us About Your Vision *</label>
            <textarea id="message" name="message" required rows="5" class="input-field resize-none" placeholder="What's the occasion? Any specific style, must-have shots, or vibe you're going for? The more detail the better!"></textarea>
          </div>

          <!-- GDPR Consent -->
          <div class="mb-6">
            <div class="flex items-start gap-3">
              <input type="checkbox" id="consent" name="consent" required class="mt-1 w-4 h-4 rounded border-slate-300 text-slate-900 focus:ring-2 focus:ring-slate-500" />
              <label for="consent" class="text-sm text-slate-600 leading-relaxed">
                I agree to Photocut4u storing my details to respond to my enquiry.
                <a href="/privacy" class="text-amber-500 hover:underline ml-1">Privacy Policy</a>
                <span class="hidden sm:inline"> — no spam, ever.</span>
              </label>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-4">
            <button type="submit" id="submit-btn" class="btn btn-accent px-8 py-3 group">
              <span class="btn-text">Send Enquiry</span>
              <span class="btn-loading hidden items-center gap-2">
                <Loader2 class="w-5 h-5 animate-spin" aria-hidden="true" />
                Sending...
              </span>
              <ChevronRight class="w-5 h-5 ml-2 transition-transform group-hover:translate-x-1" aria-hidden="true" />
            </button>
            <a href="https://calendly.com/photocut4u" target="_blank" rel="noopener noreferrer" class="btn btn-dark justify-center">
              Book a Free Call Instead
            </a>
          </div>

          <!-- Success/Error Messages -->
          <div id="form-message" class="mt-6 hidden" role="alert"></div>
        </form>
      </div>
    </div>
  </div>

  <script>
    // Get URL param for service pre-selection
    const urlParams = new URLSearchParams(window.location.search);
    const serviceParam = urlParams.get('service');
    if (serviceParam) {
      const select = document.getElementById('service');
      if (select) select.value = serviceParam;
    }

    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('submit-btn');
    const btnText = submitBtn.querySelector('.btn-text');
    const btnLoading = submitBtn.querySelector('.btn-loading');
    const formMessage = document.getElementById('form-message');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Validate
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);

      // Basic validation
      if (!data.name || !data.email || !data.service || !data.message || !data.consent) {
        showMessage('Please fill in all required fields.', 'error');
        return;
      }

      // Email format check
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email)) {
        showMessage('Please enter a valid email address.', 'error');
        return;
      }

      // Loading state
      submitBtn.disabled = true;
      btnText.classList.add('hidden');
      btnLoading.classList.remove('hidden');
      formMessage.classList.add('hidden');

      try {
        // Submit to Formspree (replace with your Formspree endpoint)
        const response = await fetch('https://formspree.io/f/mljjkyyo', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          showMessage('Thanks! We\'ll be in touch within 24 hours.', 'success');
          form.reset();
        } else {
          throw new Error('Form submission failed');
        }
      } catch (err) {
        showMessage('Something went wrong. Please try again or email us directly at Photocut4u@gmail.com', 'error');
      } finally {
        submitBtn.disabled = false;
        btnText.classList.remove('hidden');
        btnLoading.classList.add('hidden');
      }
    });

    function showMessage(text, type) {
      formMessage.textContent = text;
      formMessage.className = 'mt-6 p-4 rounded-xl ' + (type === 'success' ? 'bg-green-50 text-green-800 border border-green-200' : 'bg-red-50 text-red-800 border border-red-200');
      formMessage.classList.remove('hidden');
      formMessage.innerHTML = `
        <div class="flex items-start gap-3">
          ${type === 'success'
            ? '<svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>'
            : '<svg class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>'
          }
          <span>${text}</span>
        </div>
      `;
      formMessage.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    // Real-time validation feedback
    const inputs = form.querySelectorAll('input[required], select[required], textarea[required]');
    inputs.forEach(input => {
      input.addEventListener('blur', () => {
        if (input.checkValidity()) {
          input.classList.remove('border-red-300', 'focus:ring-red-500');
          input.classList.add('border-green-300', 'focus:ring-green-500');
        } else {
          input.classList.remove('border-green-300', 'focus:ring-green-500');
          input.classList.add('border-red-300', 'focus:ring-red-500');
        }
      });
    });
  </script>
</section>