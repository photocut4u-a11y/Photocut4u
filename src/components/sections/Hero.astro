---
import { Play, Camera, Video, ArrowRight, Star, Heart, Award } from 'lucide-react';
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-slate-50">
  <!-- Background Video/Image Placeholder -->
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-900/90 via-slate-800/80 to-slate-900/90" />
    <!-- YouTube embed as background (muted, autoplay, loop) -->
    <div class="absolute inset-0 opacity-30">
      <iframe
        src="https://www.youtube.com/embed/kqV0L7T8auc?autoplay=1&mute=1&loop=1&playlist=kqV0L7T8auc&controls=0&modestbranding=1&rel=0&showinfo=0"
        title="Photocut4u Showreel"
        class="w-full h-full pointer-events-none"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="eager"
      ></iframe>
    </div>
  </div>

  <!-- Content -->
  <div class="relative z-10 container-custom px-4 py-20">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 text-white text-sm font-medium mb-8 animate-fade-in">
        <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse" aria-hidden="true"></span>
        <span>Now Booking 2025/2026</span>
      </div>

      <!-- Headline -->
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold text-white leading-tight mb-6 animate-slide-up">
        We Capture Moments<br class="hidden sm:block" />
        <span class="text-amber-400">That Last Forever</span>
      </h1>

      <!-- Subheadline -->
      <p class="text-lg sm:text-xl lg:text-2xl text-slate-200 max-w-3xl mx-auto mb-10 leading-relaxed animate-slide-up" style="animation-delay: 0.1s;">
        Professional photography & videography for weddings, events, portraits & corporate.
        Cinematic storytelling that preserves your memories for a lifetime.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16 animate-slide-up" style="animation-delay: 0.2s;">
        <a href="/contact" class="btn-primary text-lg px-8 py-4 group">
          Get Your Free Quote
          <ArrowRight class="w-5 h-5 ml-2 transition-transform group-hover:translate-x-1" aria-hidden="true" />
        </a>
        <a href="/portfolio" class="btn-secondary bg-transparent border-white text-white hover:bg-white/10 text-lg px-8 py-4">
          View Our Work
        </a>
      </div>

      <!-- Trust Indicators -->
      <div class="flex flex-wrap items-center justify-center gap-8 text-sm text-slate-300 animate-slide-up" style="animation-delay: 0.3s;">
        <div class="flex items-center gap-2">
          <Star class="w-5 h-5 text-amber-400" aria-hidden="true" />
          <span>5.0 Google Reviews</span>
        </div>
        <div class="flex items-center gap-2">
          <Heart class="w-5 h-5 text-red-400" aria-hidden="true" />
          <span>100+ Happy Clients</span>
        </div>
        <div class="flex items-center gap-2">
          <Award class="w-5 h-5 text-amber-400" aria-hidden="true" />
          <span>Award Winning</span>
        </div>
        <div class="flex items-center gap-2">
          <Camera class="w-5 h-5 text-slate-400" aria-hidden="true" />
          <Video class="w-5 h-5 ml-1 text-slate-400" aria-hidden="true" />
          <span>Photo & Video</span>
        </div>
      </div>

      <!-- Scroll Indicator -->
      <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce">
        <a href="#portfolio" class="text-slate-400 hover:text-white transition-colors" aria-label="Scroll to portfolio">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>