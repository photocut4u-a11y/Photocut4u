---
import { ChevronRight, Camera, Video, Play, Heart } from 'lucide-react';

const portfolioItems = [
  {
    id: 1,
    title: '60th Birthday Cinematic Reveal',
    category: 'Events',
    description: 'Surprise 60th birthday celebration with family from across the UK. Emotional reveal captured in 4K cinematic.',
    image: 'https://images.unsplash.com/photo-1511795409834-ef04bbd61622?w=1200&h=800&fit=crop',
    videoUrl: 'https://www.youtube.com/watch?v=xY0SvPOWkJE',
    type: 'video',
    tags: ['Cinematic Video', 'Event Coverage', 'Family'],
    date: 'March 2024',
    location: 'London, UK',
  },
  {
    id: 2,
    title: 'Sarah & James Wedding',
    category: 'Weddings',
    description: 'Beautiful countryside wedding at a historic manor. Full day coverage from prep to sparkler exit.',
    image: 'https://images.unsplash.com/photo-1519741497674-611481863552?w=1200&h=800&fit=crop',
    type: 'photo',
    tags: ['Wedding Photography', 'Highlight Film', 'Couples Portraits'],
    date: 'June 2024',
    location: 'Berkshire, UK',
  },
  {
    id: 3,
    title: 'JCNIC Worship Night',
    category: 'Church',
    description: 'Monthly worship night with 300+ attendees. Multi-camera live stream + highlight video for social media.',
    image: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=1200&h=800&fit=crop',
    videoUrl: 'https://www.youtube.com/watch?v=gO8GX6g67jE',
    type: 'video',
    tags: ['Live Streaming', 'Event Video', 'Multi-Cam'],
    date: 'Monthly',
    location: 'Slough, UK',
  },
  {
    id: 4,
    title: 'Corporate Event - TechConf 2024',
    category: 'Corporate',
    description: 'Two-day tech conference with keynote speakers, panel discussions, and networking. Same-day delivery for social.',
    image: 'https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=1200&h=800&fit=crop',
    type: 'photo',
    tags: ['Corporate Photography', 'Event Coverage', 'Headshots'],
    date: 'April 2024',
    location: 'Reading, UK',
  },
  {
    id: 5,
    title: 'Baby Annabelle Newborn Session',
    category: 'Portraits',
    description: 'Lifestyle newborn session at family home. Baby-led pacing with sibling and family portraits included.',
    image: 'https://images.unsplash.com/photo-1518831959646-742c3a14ebf7?w=1200&h=800&fit=crop',
    type: 'photo',
    tags: ['Newborn Photography', 'Family Portraits', 'Lifestyle'],
    date: 'February 2024',
    location: 'Windsor, UK',
  },
  {
    id: 6,
    title: 'Party Table Cinematic',
    category: 'Events',
    description: 'Intimate dinner party with cinematic table-scaping reveal. Short-form content for Instagram/TikTok.',
    image: 'https://images.unsplash.com/photo-1519167758481-83f550bb49b3?w=1200&h=800&fit=crop',
    videoUrl: 'https://www.youtube.com/watch?v=45Sl0UnE9lc',
    type: 'video',
    tags: ['Social Content', 'Cinematic', 'Food & Drink'],
    date: 'January 2024',
    location: 'Slough, UK',
  },
  {
    id: 7,
    title: 'Emma & David Engagement',
    category: 'Weddings',
    description: 'Golden hour engagement session in Richmond Park. Relaxed, natural, romantic.',
    image: 'https://images.unsplash.com/photo-1583939003579-423e4e5f5a2d?w=1200&h=800&fit=crop',
    type: 'photo',
    tags: ['Engagement', 'Couples', 'Golden Hour'],
    date: 'May 2024',
    location: 'Richmond, UK',
  },
  {
    id: 8,
    title: 'Miles 1st Birthday Cake Smash',
    category: 'Portraits',
    description: 'Colorful cake smash session with custom backdrop. Studio + lifestyle mix.',
    image: 'https://images.unsplash.com/photo-1560807707-8cc77767d783?w=1200&h=800&fit=crop',
    type: 'photo',
    tags: ['Cake Smash', 'Milestone', 'Studio'],
    date: 'July 2024',
    location: 'Studio, Slough',
  },
  {
    id: 9,
    title: 'Corporate Headshots - FinTech Startup',
    category: 'Corporate',
    description: 'Team of 25 headshots + office environment shots for website and LinkedIn.',
    image: 'https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?w=1200&h=800&fit=crop',
    type: 'photo',
    tags: ['Corporate Headshots', 'Team Photos', 'Branding'],
    date: 'August 2024',
    location: 'London, UK',
  },
];

const categories = ['All', 'Weddings', 'Events', 'Portraits', 'Corporate', 'Church'];
---

<section class="section bg-white" aria-labelledby="portfolio-heading">
  <div class="container-custom">
    <div class="text-center mb-12">
      <h1 id="portfolio-heading" class="section-title">Our Portfolio</h1>
      <p class="section-subtitle mx-auto">
        Every project tells a story. Browse our latest work across weddings, events, portraits, and corporate commissions.
      </p>
    </div>

    <!-- Category Filter -->
    <div class="flex flex-wrap justify-center gap-3 mb-12" role="tablist" aria-label="Filter portfolio by category">
      {categories.map((cat, i) => (
        <button
          role="tab"
          aria-selected={i === 0}
          aria-controls={`portfolio-panel-${cat.toLowerCase()}`}
          id={`tab-${cat.toLowerCase()}`}
          class={`px-6 py-2 rounded-full text-sm font-medium transition-all ${
            i === 0
              ? 'bg-slate-900 text-white shadow-lg'
              : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
          }`}
          data-category={cat.toLowerCase()}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Portfolio Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" role="tabpanel" id="portfolio-panel-all">
      {portfolioItems.map((item) => (
        <article class="card group relative overflow-hidden" data-category={item.category.toLowerCase()}>
          <div class="relative aspect-[3/2] overflow-hidden">
            <img
              src={item.image}
              alt={item.title}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            {/* Type badge */}
            <div class="absolute top-4 left-4">
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-white/90 backdrop-blur-sm text-xs font-medium shadow-lg">
                {item.type === 'video' ? (
                  <>
                    <Video class="w-3 h-3" aria-hidden="true" />
                    <span>Video</span>
                  </>
                ) : (
                  <>
                    <Camera class="w-3 h-3" aria-hidden="true" />
                    <span>Photo</span>
                  </>
                )}
              </span>
            </div>
            {/* Play button for videos */}
            {item.type === 'video' && item.videoUrl && (
              <a
                href={item.videoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="absolute top-4 right-4 w-12 h-12 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center text-white opacity-0 group-hover:opacity-100 transition-all duration-300 hover:bg-white/30 hover:scale-110"
                aria-label={`Watch ${item.title} video`}
              >
                <Play class="w-6 h-6 ml-1" aria-hidden="true" />
              </a>
            )}
            {/* Heart button */}
            <button class="absolute bottom-4 right-4 w-10 h-10 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center text-slate-600 hover:text-red-500 transition-colors opacity-0 group-hover:opacity-100" aria-label={`Add ${item.title} to favorites`}>
              <Heart class="w-5 h-5" aria-hidden="true" />
            </button>
          </div>
          <div class="p-6">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-medium text-amber-500 uppercase tracking-wider">{item.category}</span>
              <span class="text-xs text-slate-500">{item.date}</span>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-amber-500 transition-colors">{item.title}</h3>
            <p class="text-slate-600 text-sm mb-4 line-clamp-2">{item.description}</p>
            <div class="flex flex-wrap gap-2 mb-4">
              {item.tags.map((tag) => (
                <span key={tag} class="px-2 py-1 text-xs bg-slate-100 text-slate-600 rounded-full">{tag}</span>
              ))}
            </div>
            <div class="flex items-center gap-4 pt-4 border-t border-slate-100">
              <span class="text-xs text-slate-500 flex items-center gap-1">
                <Camera class="w-3 h-3" aria-hidden="true" />
                {item.location}
              </span>
              {item.type === 'video' && item.videoUrl && (
                <a
                  href={item.videoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm font-medium text-amber-500 hover:text-amber-600 flex items-center gap-1"
                >
                  Watch Film
                  <ChevronRight class="w-4 h-4" aria-hidden="true" />
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <script>
    const tabs = document.querySelectorAll('[role="tab"]');
    const cards = document.querySelectorAll('[data-category]');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const category = tab.dataset.category;

        tabs.forEach(t => {
          t.classList.remove('bg-slate-900', 'text-white', 'shadow-lg');
          t.classList.add('bg-slate-100', 'text-slate-600');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.remove('bg-slate-100', 'text-slate-600');
        tab.classList.add('bg-slate-900', 'text-white', 'shadow-lg');
        tab.setAttribute('aria-selected', 'true');

        cards.forEach(card => {
          if (category === 'all' || card.dataset.category === category) {
            card.style.display = 'block';
            card.style.animation = 'fadeIn 0.3s ease-out';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>

  <style>
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</section>