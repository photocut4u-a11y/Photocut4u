---
import { ChevronRight, Camera, Video, Heart, Star, Play } from 'lucide-react';

const portfolioItems = [
  {
    id: 1,
    title: '60th Birthday Cinematic Reveal',
    category: 'Events',
    image: 'https://images.unsplash.com/photo-1511795409834-ef04bbd61622?w=800&h=600&fit=crop',
    videoUrl: 'https://www.youtube.com/watch?v=xY0SvPOWkJE',
    type: 'video'
  },
  {
    id: 2,
    title: 'Sarah & James Wedding',
    category: 'Weddings',
    image: 'https://images.unsplash.com/photo-1519741497674-611481863552?w=800&h=600&fit=crop',
    type: 'photo'
  },
  {
    id: 3,
    title: 'JCNIC Worship Night',
    category: 'Church',
    image: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=800&h=600&fit=crop',
    videoUrl: 'https://www.youtube.com/watch?v=gO8GX6g67jE',
    type: 'video'
  },
  {
    id: 4,
    title: 'Corporate Event - TechConf 2024',
    category: 'Corporate',
    image: 'https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=800&h=600&fit=crop',
    type: 'photo'
  },
  {
    id: 5,
    title: 'Baby Annabelle Newborn Session',
    category: 'Portraits',
    image: 'https://images.unsplash.com/photo-1518831959646-742c3a14ebf7?w=800&h=600&fit=crop',
    type: 'photo'
  },
  {
    id: 6,
    title: 'Party Table Cinematic',
    category: 'Events',
    image: 'https://images.unsplash.com/photo-1519167758481-83f550bb49b3?w=800&h=600&fit=crop',
    videoUrl: 'https://www.youtube.com/watch?v=45Sl0UnE9lc',
    type: 'video'
  },
];

const categories = ['All', 'Weddings', 'Events', 'Portraits', 'Corporate', 'Church'];
---

<section id="portfolio" class="section bg-white" aria-labelledby="portfolio-heading">
  <div class="container-custom">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 id="portfolio-heading" class="section-title">Our Portfolio</h2>
      <p class="section-subtitle mx-auto">
        A curated selection of our favorite moments captured across weddings, events, portraits, and corporate work.
      </p>
    </div>

    <!-- Category Filter -->
    <div class="flex flex-wrap justify-center gap-3 mb-12" role="tablist" aria-label="Filter portfolio by category">
      {categories.map((cat, i) => (
        <button
          role="tab"
          aria-selected={i === 0}
          aria-controls={`portfolio-panel-${cat.toLowerCase()}`}
          id={`tab-${cat.toLowerCase()}`}
          class={`px-5 py-2 rounded-full text-sm font-medium transition-all ${
            i === 0
              ? 'bg-slate-900 text-white shadow-lg'
              : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
          }`}
          data-category={cat.toLowerCase()}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Portfolio Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" role="tabpanel" id="portfolio-panel-all">
      {portfolioItems.map((item) => (
        <article class="card group relative overflow-hidden" data-category={item.category.toLowerCase()}>
          <div class="relative aspect-[4/3] overflow-hidden">
            <img
              src={item.image}
              alt={item.title}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            {/* Overlay */}
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
              <div class="w-full text-white transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
                <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-amber-500/90 text-xs font-medium mb-2">
                  {item.type === 'video' ? (
                    <>
                      <Video class="w-3 h-3" aria-hidden="true" />
                      <span>Cinematic Video</span>
                    </>
                  ) : (
                    <>
                      <Camera class="w-3 h-3" aria-hidden="true" />
                      <span>Photography</span>
                    </>
                  )}
                </span>
                <h3 class="text-lg font-semibold mb-1">{item.title}</h3>
                <p class="text-slate-300 text-sm">{item.category}</p>
              </div>
            </div>
            {/* Play button for videos */}
            {item.type === 'video' && item.videoUrl && (
              <a
                href={item.videoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="absolute top-4 right-4 w-12 h-12 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center text-white opacity-0 group-hover:opacity-100 transition-all duration-300 hover:bg-white/30 hover:scale-110"
                aria-label={`Watch ${item.title} video`}
              >
                <Play class="w-6 h-6 ml-1" aria-hidden="true" />
              </a>
            )}
          </div>
          <div class="p-5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">{item.category}</span>
              <button class="p-2 text-slate-400 hover:text-red-500 transition-colors" aria-label={`Add ${item.title} to favorites`}>
                <Heart class="w-5 h-5" aria-hidden="true" />
              </button>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- View All Button -->
    <div class="text-center mt-12">
      <a href="/portfolio" class="btn-secondary inline-flex items-center gap-2">
        View All Work
        <ChevronRight class="w-5 h-5" aria-hidden="true" />
      </a>
    </div>
  </div>

  <script>
    // Simple category filter
    const tabs = document.querySelectorAll('[role="tab"]');
    const cards = document.querySelectorAll('[data-category]');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const category = tab.dataset.category;

        // Update active tab
        tabs.forEach(t => {
          t.classList.remove('bg-slate-900', 'text-white', 'shadow-lg');
          t.classList.add('bg-slate-100', 'text-slate-600');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.remove('bg-slate-100', 'text-slate-600');
        tab.classList.add('bg-slate-900', 'text-white', 'shadow-lg');
        tab.setAttribute('aria-selected', 'true');

        // Filter cards
        cards.forEach(card => {
          if (category === 'all' || card.dataset.category === category) {
            card.style.display = 'block';
            card.style.animation = 'fadeIn 0.3s ease-out';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>

  <style>
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</section>