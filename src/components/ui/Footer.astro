---
import { Mail, Phone, MapPin, Camera, Video, Heart, ArrowRight } from 'lucide-react';
---

<footer class="bg-slate-900 text-slate-300" role="contentinfo">
  <div class="container-custom py-16 lg:py-24">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Brand Column -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-2 text-white hover:opacity-80 transition-opacity mb-6" aria-label="Photocut4u Home">
          <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-white/10">
            <Camera class="w-5 h-5" aria-hidden="true" />
            <Video class="w-5 h-5 ml-1" aria-hidden="true" />
          </div>
          <span class="font-display font-bold text-xl lg:text-2xl tracking-tight">Photocut4u</span>
        </a>
        <p class="text-slate-400 text-sm leading-relaxed mb-6">
          Professional photography & videography capturing life's most precious moments. Cinematic storytelling for weddings, events, and portraits.
        </p>
        <div class="flex gap-4">
          <a href="https://www.youtube.com/@photocut4u" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-white transition-colors" aria-label="YouTube">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 7.684 0 12 0 12s0 4.316.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 16.316 24 12 24 12s0-4.316-.502-5.814zM9.545 15.568V8.432L16.98 12l-7.435 3.568z"/></svg>
          </a>
          <a href="https://instagram.com/photocut4u" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-white transition-colors" aria-label="Instagram">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.07zm0-2.163c3.259 0 3.667.014 4.947.072 4.358.2 6.78 2.618 6.979 6.98.02 1.282.03 1.682.03 4.947 0 3.26-.014 3.667-.03 4.947-.2 4.358-2.618 6.78-6.98 6.98-1.282.02-1.682.03-4.947.03-4.358 0-6.78-2.618-6.98-6.98-.02-1.281-.03-1.681-.03-4.947 0-3.26.014-3.667.03-4.948.2-4.358 2.618-6.78 6.98-6.98 1.281-.02 1.681-.03 4.947-.03zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.163-6.162-6.163zm0 10.162c-2.209 0-4-1.79-4-4s1.791-4 4-4 4 1.791 4 4-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44 1.44-.645 1.44-1.44-.645-1.44-1.44-1.44z"/></svg>
          </a>
          <a href="https://facebook.com/photocut4u" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-white transition-colors" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
        </div>
      </div>
      <!-- Services -->
      <div>
        <h3 class="text-white font-semibold text-lg mb-4">Services</h3>
        <ul class="space-y-3 text-sm">
          <li><a href="/services#weddings" class="hover:text-white transition-colors">Wedding & Engagement</a></li>
          <li><a href="/services#events" class="hover:text-white transition-colors">Events & Parties</a></li>
          <li><a href="/services#portraits" class="hover:text-white transition-colors">Portraits & Family</a></li>
          <li><a href="/services#corporate" class="hover:text-white transition-colors">Corporate & Commercial</a></li>
          <li><a href="/services#church" class="hover:text-white transition-colors">Church & Worship</a></li>
        </ul>
      </div>
      <!-- Quick Links -->
      <div>
        <h3 class="text-white font-semibold text-lg mb-4">Quick Links</h3>
        <ul class="space-y-3 text-sm">
          <li><a href="/portfolio" class="hover:text-white transition-colors">Portfolio</a></li>
          <li><a href="/about" class="hover:text-white transition-colors">About Us</a></li>
          <li><a href="/services" class="hover:text-white transition-colors">Services & Pricing</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Get a Quote</a></li>
        </ul>
      </div>
      <!-- Contact -->
      <div>
        <h3 class="text-white font-semibold text-lg mb-4">Contact Us</h3>
        <ul class="space-y-3 text-sm">
          <li class="flex items-center gap-2">
            <Mail class="w-4 h-4 text-slate-400" aria-hidden="true" />
            <a href="mailto:hello@photocut4u.tech" class="hover:text-white transition-colors">hello@photocut4u.tech</a>
          </li>
          <li class="flex items-center gap-2">
            <Phone class="w-4 h-4 text-slate-400" aria-hidden="true" />
            <a href="tel:+447XXXYYYYYY" class="hover:text-white transition-colors">+44 7XXX YYY YYY</a>
          </li>
          <li class="flex items-center gap-2">
            <MapPin class="w-4 h-4 text-slate-400" aria-hidden="true" />
            <span>Slough, Berkshire, UK</span>
          </li>
          <li class="flex items-center gap-2">
            <Camera class="w-4 h-4 text-slate-400" aria-hidden="true" />
            <a href="https://www.youtube.com/@photocut4u" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">YouTube Channel</a>
          </li>
        </ul>
      </div>
    </div>
    <!-- Bottom Bar -->
    <div class="border-t border-slate-800 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-slate-500 text-sm">
        &copy; {new Date().getFullYear()} Photocut4u. All rights reserved.
      </p>
      <div class="flex items-center gap-6 text-sm text-slate-500">
        <a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-white transition-colors">Terms of Service</a>
        <a href="/cookies" class="hover:text-white transition-colors">Cookie Policy</a>
      </div>
    </div>
  </div>
</footer>