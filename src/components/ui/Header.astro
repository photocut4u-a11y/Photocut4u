---
import { Camera, Video, Menu, MapPin } from 'lucide-react';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-[var(--color-dark)] border-b border-[var(--color-dark-sm)] transition-shadow" style="box-shadow: 0 1px 0 rgba(0,0,0,0.2);">
  <nav class="container-custom" aria-label="Main navigation">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 text-white hover:opacity-80 transition-opacity" aria-label="Photocut4u Home">
        <svg width="40" height="40" viewBox="0 0 100 100" aria-hidden="true">
          <defs>
            <linearGradient id="p4u-grad2" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#E76F51"/>
              <stop offset="100%" stop-color="#D85A3A"/>
            </linearGradient>
          </defs>
          <text x="50" y="72" text-anchor="middle" font-family="'Lato', 'sans-serif" font-size="38" font-weight="700" fill="url(#p4u-grad2)">P</text>
          <g transform="translate(58, 25) scale(0.8)">
            <circle cx="40" cy="40" r="18" fill="none" stroke="#fff" stroke-width="3"/>
            <circle cx="40" cy="40" r="5" fill="#fff"/>
            <line x1="40" y1="28" x2="40" y2="52" stroke="#fff" stroke-width="2"/>
            <line x1="28" y1="40" x2="52" y2="40" stroke="#fff" stroke-width="2"/>
            <line x1="31" y1="31" x2="49" y2="49" stroke="#fff" stroke-width="1.5"/>
            <line x1="49" y1="31" x2="31" y2="49" stroke="#fff" stroke-width="1.5"/>
          </g>
          <text x="80" y="72" text-anchor="middle" font-family="'Lato', 'sans-serif" font-size="38" font-weight="700" fill="url(#p4u-grad2)">U</text>
        </svg>
        <span class="font-serif font-bold text-xl lg:text-2xl tracking-tight">Photocut4u</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-1">
        <a href="/portfolio" class="px-4 py-2 text-[var(--color-text)] hover:text-white hover:bg-[var(--color-dark-sm)] rounded-lg text-sm font-medium transition-colors">Portfolio</a>
        <a href="/services" class="px-4 py-2 text-[var(--color-text)] hover:text-white hover:bg-[var(--color-dark-sm)] rounded-lg text-sm font-medium transition-colors">Services</a>
        <a href="/about" class="px-4 py-2 text-[var(--color-text)] hover:text-white hover:bg-[var(--color-dark-sm)] rounded-lg text-sm font-medium transition-colors">About</a>
        <a href="/contact" class="px-5 py-2.5 rounded-lg bg-[#E76F51] text-white text-sm font-semibold hover:bg-[#e45c3b] transition-colors shadow-sm">Book a Shoot</a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        class="lg:hidden p-2 rounded-lg text-white hover:text-white hover:bg-[var(--color-dark-sm)] transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-mobile-menu-toggle
      >
        <Menu class="w-6 h-6" aria-hidden="true" />
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden overflow-hidden max-h-0 transition-all duration-300 ease-out bg-[var(--color-dark)] border-t border-[var(--color-dark-sm)]" data-mobile-menu>
    <div class="px-4 py-4 space-y-1">
      <a href="/portfolio" class="block px-4 py-3 text-[var(--color-text)] hover:bg-[var(--color-dark-sm)] rounded-lg font-medium transition-colors">Portfolio</a>
      <a href="/services" class="block px-4 py-3 text-[var(--color-text)] hover:bg-[var(--color-dark-sm)] rounded-lg font-medium transition-colors">Services</a>
      <a href="/about" class="block px-4 py-3 text-[var(--color-text)] hover:bg-[var(--color-dark-sm)] rounded-lg font-medium transition-colors">About</a>
      <a href="/contact" class="block px-4 py-3 bg-[#E76F51] text-white rounded-lg font-semibold transition-colors">Book a Shoot</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-mobile-menu-toggle]');
  const menu = document.querySelector('[data-mobile-menu]');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('max-h-96');
      menu.classList.toggle('opacity-100');
      toggle.setAttribute('aria-expanded', isOpen);
      toggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
    });
  }
</script>
