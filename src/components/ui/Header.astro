---
import { Camera, Video, Menu, MapPin } from 'lucide-react';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-slate-100 transition-shadow" style="box-shadow: 0 1px 0 rgba(0,0,0,0.04);">
  <nav class="container-custom" aria-label="Main navigation">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 text-slate-900 hover:opacity-80 transition-opacity" aria-label="Photocut4u Home">
        <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-slate-900 text-white shadow-sm">
          <Camera class="w-5 h-5" aria-hidden="true" />
          <Video class="w-5 h-5 ml-1" aria-hidden="true" />
        </div>
        <span class="font-display font-bold text-xl lg:text-2xl tracking-tight">Photocut4u</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-1">
        <a href="/portfolio" class="px-4 py-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg text-sm font-medium transition-colors">Portfolio</a>
        <a href="/services" class="px-4 py-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg text-sm font-medium transition-colors">Services</a>
        <a href="/about" class="px-4 py-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg text-sm font-medium transition-colors">About</a>
        <a href="/contact" class="px-5 py-2.5 rounded-lg bg-slate-900 text-white text-sm font-semibold hover:bg-slate-700 transition-colors shadow-sm">Book a Shoot</a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        class="lg:hidden p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-mobile-menu-toggle
      >
        <Menu class="w-6 h-6" aria-hidden="true" />
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden overflow-hidden max-h-0 transition-all duration-300 ease-out bg-white border-t border-slate-100" data-mobile-menu>
    <div class="px-4 py-4 space-y-1">
      <a href="/portfolio" class="block px-4 py-3 text-slate-700 hover:bg-slate-50 rounded-lg font-medium transition-colors">Portfolio</a>
      <a href="/services" class="block px-4 py-3 text-slate-700 hover:bg-slate-50 rounded-lg font-medium transition-colors">Services</a>
      <a href="/about" class="block px-4 py-3 text-slate-700 hover:bg-slate-50 rounded-lg font-medium transition-colors">About</a>
      <a href="/contact" class="block px-4 py-3 bg-slate-900 text-white rounded-lg font-semibold transition-colors">Book a Shoot</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-mobile-menu-toggle]');
  const menu = document.querySelector('[data-mobile-menu]');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('max-h-96');
      menu.classList.toggle('opacity-100');
      toggle.setAttribute('aria-expanded', isOpen);
      toggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
    });
  }
</script>
