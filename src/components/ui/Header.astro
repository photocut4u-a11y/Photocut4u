---
import { Camera, Video, Menu, X } from 'lucide-react';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-slate-100 transition-all duration-300">
  <nav class="container-custom" aria-label="Main navigation">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 text-slate-900 hover:opacity-80 transition-opacity" aria-label="Photocut4u Home">
        <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-slate-900 text-white">
          <Camera class="w-5 h-5" aria-hidden="true" />
          <Video class="w-5 h-5 ml-1" aria-hidden="true" />
        </div>
        <span class="font-display font-bold text-xl lg:text-2xl tracking-tight">Photocut4u</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-8">
        <a href="/portfolio" class="text-slate-600 hover:text-slate-900 font-medium transition-colors">Portfolio</a>
        <a href="/services" class="text-slate-600 hover:text-slate-900 font-medium transition-colors">Services</a>
        <a href="/about" class="text-slate-600 hover:text-slate-900 font-medium transition-colors">About</a>
        <a href="/contact" class="btn-primary text-sm">Get a Quote</a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        class="lg:hidden p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-mobile-menu-toggle
      >
        <Menu class="w-6 h-6" aria-hidden="true" />
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="lg:hidden overflow-hidden max-h-0 transition-all duration-300 ease-out bg-white border-t border-slate-100" data-mobile-menu>
      <div class="py-6 space-y-4 px-4">
        <a href="/portfolio" class="block py-2 text-slate-600 hover:text-slate-900 font-medium transition-colors">Portfolio</a>
        <a href="/services" class="block py-2 text-slate-600 hover:text-slate-900 font-medium transition-colors">Services</a>
        <a href="/about" class="block py-2 text-slate-600 hover:text-slate-900 font-medium transition-colors">About</a>
        <a href="/contact" class="btn-primary w-full justify-center mt-2">Get a Quote</a>
      </div>
    </div>
  </nav>

  <script>
    // Mobile menu toggle
    const toggle = document.querySelector('[data-mobile-menu-toggle]');
    const menu = document.querySelector('[data-mobile-menu]');
    if (toggle && menu) {
      toggle.addEventListener('click', () => {
        const isOpen = menu.classList.toggle('max-h-96');
        menu.classList.toggle('opacity-0');
        toggle.setAttribute('aria-expanded', isOpen);
        toggle.innerHTML = isOpen
          ? '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>'
          : '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>';
      });
    }
  </script>
</header>