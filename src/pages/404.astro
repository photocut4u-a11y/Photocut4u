---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Home, Search, ArrowLeft } from 'lucide-react';
---

<BaseLayout title="Page Not Found | Photocut4u">
  <section class="section bg-white min-h-[60vh] flex items-center justify-center">
    <div class="container-custom text-center">
      <div class="w-24 h-24 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-8">
        <Search class="w-12 h-12 text-slate-400" aria-hidden="true" />
      </div>
      <h1 class="text-4xl lg:text-6xl font-bold text-slate-900 mb-4">404</h1>
      <h2 class="text-2xl lg:text-3xl text-slate-600 mb-6">Page Not Found</h2>
      <p class="text-lg text-slate-500 max-w-md mx-auto mb-10">
        Sorry, we couldn't find the page you're looking for. It might have been moved or doesn't exist.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/" class="btn-primary inline-flex items-center gap-2">
          <Home class="w-5 h-5" aria-hidden="true" />
          Back to Home
        </a>
        <a href="/portfolio" class="btn-secondary inline-flex items-center gap-2">
          <ArrowLeft class="w-5 h-5" aria-hidden="true" />
          Browse Portfolio
        </a>
      </div>
    </div>
  </section>
</BaseLayout>